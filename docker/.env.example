# ==============================================================================
# SECURE EXECUTION SANDBOX RUNTIME - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Application Settings
ENVIRONMENT=production
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production

# Worker Resource Quotas
MAX_MEMORY_MB=256
CPU_QUOTA_VCPU=0.5
DEFAULT_TIMEOUT_SECONDS=5.0
MAX_TIMEOUT_SECONDS=30.0
MAX_OUTPUT_BYTES=1048576

# WebAssembly Runtime Controls
WASM_MAX_MEMORY_BYTES=16777216
WASM_DEFAULT_FUEL=50000000
WASM_ENABLE_EPOCH_INTERRUPTION=true
WASM_EPOCH_INTERVAL_MS=10

# Hardened Container Worker
CONTAINER_IMAGE=sandbox-runner:latest
CONTAINER_USER=65534:65534
CONTAINER_READ_ONLY_ROOT=true

# Egress Network Filtering Proxy
EGRESS_PROXY_HOST=127.0.0.1
EGRESS_PROXY_PORT=8080
DEFAULT_ALLOW_NETWORK=false

# Redis & Coordination
REDIS_URL=redis://localhost:6379/0
